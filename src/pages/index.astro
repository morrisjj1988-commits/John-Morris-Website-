---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import NewsCard from '../components/NewsCard.astro';
import Newsletter from '../components/Newsletter.astro';
import PlaceholderPhoto from '../components/PlaceholderPhoto.astro';
import { helpCategories } from '../lib/site';
import { withBase } from '../lib/url';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('news', ({ data }) => !data.draft);
const latestPosts = allPosts.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf()).slice(0, 6);
---

<BaseLayout
  title="Cllr John Morris"
  description="John Morris is your local councillor for Canning Town South on Newham Council. Get help with housing, council tax, planning and more, and follow the latest local news."
>
  <Hero />

  <section class="section quote-section">
    <div class="container quote-grid">
      <div class="quote-media">
        <PlaceholderPhoto label="Photo placeholder — Cllr John Morris in Canning Town South" tone="navy" ratio="4 / 5" />
      </div>
      <div class="quote-copy">
        <p class="eyebrow">In his own words</p>
        <blockquote>
          "Canning Town South is changing fast — new homes, new neighbours, and real pressure on services. My job
          is simple: listen to residents, chase up the problems that matter to you, and make sure this community
          gets its fair share from the council."
        </blockquote>
        <p class="quote-attribution">— John Morris, Councillor for Canning Town South</p>
        <a class="btn btn-outline-dark" href={withBase('/about/')}>More about John</a>
      </div>
    </div>
  </section>

  <section class="section section-alt">
    <div class="container">
      <div class="section-header center-header">
        <p class="eyebrow">Casework</p>
        <h2>How can I help you?</h2>
        <p class="text-muted">
          As your councillor, I can help you cut through council bureaucracy and get problems sorted —
          from housing repairs to bins, benefits, and anti-social behaviour.
        </p>
      </div>

      <div class="grid grid-3">
        {helpCategories.slice(0, 3).map((item) => (
          <div class="card help-preview-card">
            <h3>{item.title}</h3>
            <p class="text-muted">{item.description}</p>
          </div>
        ))}
      </div>

      <div class="center help-cta">
        <a class="btn btn-primary" href={withBase('/find-help/')}>See how I can help &rarr;</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-header">
        <p class="eyebrow">Latest updates</p>
        <h2>News from Canning Town South</h2>
      </div>

      <div class="grid grid-3">
        {latestPosts.map((post) => (
          <NewsCard
            slug={post.id}
            title={post.data.title}
            date={post.data.date}
            category={post.data.category}
            excerpt={post.data.excerpt}
            imageAlt={post.data.imageAlt}
          />
        ))}
      </div>

      <div class="center help-cta">
        <a class="btn btn-secondary news-all-link" href={withBase('/news/')}>See all news &rarr;</a>
      </div>
    </div>
  </section>

  <section class="section section-alt">
    <div class="container">
      <Newsletter />
    </div>
  </section>
</BaseLayout>

<style>
  .quote-grid {
    display: grid;
    grid-template-columns: 0.7fr 1.3fr;
    gap: 3rem;
    align-items: center;
  }

  .quote-media {
    max-width: 20rem;
  }

  blockquote {
    margin: 0 0 1rem;
    font-family: var(--font-heading);
    font-size: 1.5rem;
    font-style: italic;
    line-height: 1.4;
    color: var(--color-navy-900);
  }

  @media (prefers-color-scheme: dark) {
    blockquote { color: #fff; }
  }

  .quote-attribution {
    font-weight: 600;
    color: var(--color-text-muted);
    margin-bottom: 1.5rem;
  }

  @media (max-width: 820px) {
    .quote-grid {
      grid-template-columns: 1fr;
    }

    .quote-media {
      max-width: 14rem;
      margin-inline: auto;
    }
  }

  .center-header {
    margin-inline: auto;
    text-align: center;
  }

  .help-preview-card {
    padding: 1.6rem;
  }

  .help-cta {
    margin-top: 2.5rem;
  }

  .news-all-link {
    color: var(--color-navy-900);
    border-color: var(--color-navy-900);
  }

  @media (prefers-color-scheme: dark) {
    .news-all-link { color: #fff; border-color: #fff; }
  }
</style>
