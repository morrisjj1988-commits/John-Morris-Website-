---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import NewsCard from '../components/NewsCard.astro';
import Newsletter from '../components/Newsletter.astro';
import { Icon } from 'astro-icon/components';
import { helpCategories } from '../lib/site';
import { withBase } from '../lib/url';
import { getCollection } from 'astro:content';

const campaigns = [
  {
    tag: 'Road Safety',
    title: 'Road Safety Campaign',
    body: 'Pressing for measures to slow traffic and protect pedestrians on the streets residents raise with me most.',
    href: '/road-safety-campaign/',
  },
  {
    tag: 'Community',
    title: 'Caxton Street Car Wash Noise Campaign',
    body: 'Working with residents and the Council on noise from the Caxton Street North car wash, after enforcement limits lapsed.',
    href: '/caxton-street-car-wash-campaign/',
  },
];

const allPosts = await getCollection('news', ({ data }) => !data.draft);
const latestPosts = allPosts.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf()).slice(0, 6);
---

<BaseLayout
  title="Cllr John Morris"
  description="John Morris is your local councillor for Canning Town South on Newham Council. Get help with housing, council tax, planning and more, and follow the latest local news."
>
  <Hero />

  <section class="section section-alt">
    <div class="container">
      <div class="section-header center-header">
        <p class="eyebrow">Casework</p>
        <h2>How can I help you?</h2>
        <p class="text-muted">
          As your councillor, I can help you cut through council bureaucracy and get problems sorted —
          from housing repairs to bins, benefits, and anti-social behaviour.
        </p>
      </div>

      <div class="grid grid-3">
        {helpCategories.slice(0, 3).map((item) => (
          <div class="card card--accent help-preview-card">
            <span class="card-icon"><Icon name={item.icon} width={19} height={19} /></span>
            <h3>{item.title}</h3>
            <p class="text-muted">{item.description}</p>
          </div>
        ))}
      </div>

      <div class="center help-cta">
        <a class="btn btn-primary" href={withBase('/find-help/')}>See how I can help &rarr;</a>
      </div>
    </div>
  </section>

  <section class="section campaigns-band">
    <div class="container">
      <div class="section-header">
        <p class="eyebrow campaigns-band__eyebrow">Active campaigns</p>
        <h2>What I'm pushing for right now</h2>
      </div>
      <div class="grid grid-2">
        {campaigns.map((campaign) => (
          <div class="campaign-card">
            <span class="campaign-card__tag">{campaign.tag}</span>
            <h3>{campaign.title}</h3>
            <p>{campaign.body}</p>
            <a class="campaign-card__link" href={withBase(campaign.href)}>Follow this campaign &rarr;</a>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-header">
        <p class="eyebrow">Latest updates</p>
        <h2>News from Canning Town South</h2>
      </div>

      {latestPosts.length > 0 ? (
        <>
          <div class="grid grid-3 grid-sparse">
            {latestPosts.map((post) => (
              <NewsCard
                slug={post.id}
                title={post.data.title}
                date={post.data.date}
                category={post.data.category}
                excerpt={post.data.excerpt}
                imageAlt={post.data.imageAlt}
              />
            ))}
          </div>

          <div class="center help-cta">
            <a class="btn btn-secondary" href={withBase('/news/')}>See all news &rarr;</a>
          </div>
        </>
      ) : (
        <p class="text-muted no-news">No news posted yet — check back soon.</p>
      )}
    </div>
  </section>

  <section class="section section-alt">
    <div class="container">
      <Newsletter formspreeEndpoint="https://formspree.io/f/xkodbqre" />
    </div>
  </section>
</BaseLayout>

<style>
  .no-news {
    text-align: center;
    padding-block: 1rem 1.5rem;
  }

  .center-header {
    margin-inline: auto;
    text-align: center;
  }

  .help-preview-card {
    padding: 1.6rem;
  }

  .help-cta {
    margin-top: 2.5rem;
  }

  .campaigns-band {
    background: var(--color-navy-900);
    color: var(--color-paper);
  }

  .campaigns-band :global(h2) {
    color: var(--color-paper);
  }

  .campaigns-band__eyebrow {
    color: var(--color-gold-500);
  }

  .campaign-card {
    background: rgba(246, 243, 236, 0.05);
    border: 1px solid rgba(246, 243, 236, 0.16);
    padding: 26px;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .campaign-card__tag {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-gold-500);
    font-weight: 500;
  }

  .campaign-card h3 {
    color: var(--color-paper);
    margin: 0;
  }

  .campaign-card p {
    color: #c7cdd8;
    margin: 0;
  }

  .campaign-card__link {
    font-weight: 700;
    font-size: 0.9rem;
    text-decoration: none;
    color: var(--color-gold-500);
    border-bottom: 2px solid var(--color-gold-500);
    padding-bottom: 2px;
    align-self: flex-start;
  }

  .campaign-card__link:hover {
    color: #fff;
    border-color: #fff;
  }
</style>
