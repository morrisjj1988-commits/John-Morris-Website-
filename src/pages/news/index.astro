---
import BaseLayout from '../../layouts/BaseLayout.astro';
import NewsCard from '../../components/NewsCard.astro';
import { getCollection } from 'astro:content';

const allPosts = (await getCollection('news', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);

const categories = ['All', ...Array.from(new Set(allPosts.map((post) => post.data.category)))];
---

<BaseLayout
  title="News & Updates"
  description="The latest news, campaigns, and local wins from Cllr John Morris in Canning Town South, Newham."
>
  <section class="section page-intro">
    <div class="container page-intro__inner">
      <p class="eyebrow">News</p>
      <h1>News &amp; updates</h1>
      <p class="text-muted">
        Campaigns, casework wins, and what's happening locally in Canning Town South.
      </p>
    </div>
  </section>

  <section class="section section-alt">
    <div class="container">
      {allPosts.length > 0 ? (
        <>
          <div class="filters" role="group" aria-label="Filter news by category">
            {categories.map((category, index) => (
              <button
                type="button"
                class="filter-btn"
                data-category={category}
                aria-pressed={index === 0 ? 'true' : 'false'}
              >
                {category}
              </button>
            ))}
          </div>

          <div class="grid grid-3 grid-sparse" id="news-grid">
            {allPosts.map((post) => (
              <div class="news-grid-item" data-category={post.data.category}>
                <NewsCard
                  slug={post.id}
                  title={post.data.title}
                  date={post.data.date}
                  category={post.data.category}
                  excerpt={post.data.excerpt}
                  imageAlt={post.data.imageAlt}
                />
              </div>
            ))}
          </div>

          <p id="news-empty" class="text-muted" hidden>No updates in this category yet — check back soon.</p>
        </>
      ) : (
        <p class="text-muted no-news">No news posted yet — check back soon.</p>
      )}
    </div>
  </section>
</BaseLayout>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>('.filter-btn');
  const items = document.querySelectorAll<HTMLElement>('.news-grid-item');
  const empty = document.getElementById('news-empty');

  buttons.forEach((button) => {
    button.addEventListener('click', () => {
      buttons.forEach((b) => b.setAttribute('aria-pressed', 'false'));
      button.setAttribute('aria-pressed', 'true');

      const category = button.dataset.category;
      let visibleCount = 0;

      items.forEach((item) => {
        const show = category === 'All' || item.dataset.category === category;
        item.style.display = show ? '' : 'none';
        if (show) visibleCount += 1;
      });

      if (empty) empty.hidden = visibleCount !== 0;
    });
  });
</script>

<style>
  .page-intro__inner {
    max-width: 44rem;
  }

  .no-news {
    text-align: center;
    padding-block: 1rem;
  }

  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-bottom: 2rem;
  }

  .filter-btn {
    font: inherit;
    font-weight: 600;
    font-size: 0.9rem;
    padding: 0.5em 1.1em;
    border-radius: 999px;
    border: 1.5px solid var(--color-border);
    background: var(--color-surface);
    color: var(--color-text);
    cursor: pointer;
  }

  .filter-btn[aria-pressed='true'] {
    background: var(--color-navy-900);
    border-color: var(--color-navy-900);
    color: #fff;
  }
</style>
