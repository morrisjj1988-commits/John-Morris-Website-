---
import BaseLayout from '../../layouts/BaseLayout.astro';
import NewsCard from '../../components/NewsCard.astro';
import { getCollection } from 'astro:content';
import { slugifyCategory } from '../../lib/newsCategories';

const allPosts = (await getCollection('news', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);

const categories = ['All', ...Array.from(new Set(allPosts.map((post) => post.data.category)))];
---

<BaseLayout
  title="News & Updates"
  description="The latest news, campaigns, and local wins from Cllr John Morris in Canning Town South, Newham."
>
  <section class="section page-intro">
    <div class="container page-intro__inner">
      <p class="eyebrow">News</p>
      <h1>News &amp; updates</h1>
      <p class="text-muted">
        Campaigns, casework wins, and what's happening locally in Canning Town South.
      </p>
    </div>
  </section>

  <section class="section section-alt">
    <div class="container">
      {allPosts.length > 0 ? (
        <>
          <div class="filters" role="group" aria-label="Filter news by category">
            {categories.map((category, index) => (
              <button
                type="button"
                class="filter-btn"
                data-category={category}
                data-slug={category === 'All' ? 'all' : slugifyCategory(category)}
                aria-pressed={index === 0 ? 'true' : 'false'}
              >
                {category}
              </button>
            ))}
          </div>

          <div class="grid grid-3 grid-sparse" id="news-grid">
            {allPosts.map((post) => (
              <div
                class="news-grid-item"
                data-category={post.data.category}
                data-slug={slugifyCategory(post.data.category)}
              >
                <NewsCard
                  slug={post.id}
                  title={post.data.title}
                  date={post.data.date}
                  category={post.data.category}
                  excerpt={post.data.excerpt}
                  imageAlt={post.data.imageAlt}
                />
              </div>
            ))}
          </div>

          <p id="news-empty" class="text-muted" hidden>No updates in this category yet — check back soon.</p>
        </>
      ) : (
        <p class="text-muted no-news">No news posted yet — check back soon.</p>
      )}
    </div>
  </section>
</BaseLayout>

<script>
  import { ALL_CATEGORY_SLUG } from '../../lib/newsCategories';

  const buttons = document.querySelectorAll<HTMLButtonElement>('.filter-btn');
  const items = document.querySelectorAll<HTMLElement>('.news-grid-item');
  const empty = document.getElementById('news-empty');
  const knownSlugs = new Set(Array.from(buttons).map((b) => b.dataset.slug));

  function applyFilter(requestedSlug: string, updateUrl: boolean) {
    const slug = knownSlugs.has(requestedSlug) ? requestedSlug : ALL_CATEGORY_SLUG;

    buttons.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.slug === slug)));

    let visibleCount = 0;
    items.forEach((item) => {
      const show = slug === ALL_CATEGORY_SLUG || item.dataset.slug === slug;
      item.style.display = show ? '' : 'none';
      if (show) visibleCount += 1;
    });

    if (empty) empty.hidden = visibleCount !== 0;

    if (updateUrl) {
      const url = new URL(window.location.href);
      if (slug === ALL_CATEGORY_SLUG) {
        url.searchParams.delete('category');
      } else {
        url.searchParams.set('category', slug);
      }
      window.history.pushState({ category: slug }, '', url);
    }
  }

  buttons.forEach((button) => {
    button.addEventListener('click', () => {
      applyFilter(button.dataset.slug ?? ALL_CATEGORY_SLUG, true);
    });
  });

  window.addEventListener('popstate', () => {
    const slug = new URLSearchParams(window.location.search).get('category') ?? ALL_CATEGORY_SLUG;
    applyFilter(slug, false);
  });

  const initialSlug = new URLSearchParams(window.location.search).get('category') ?? ALL_CATEGORY_SLUG;
  applyFilter(initialSlug, false);
</script>

<style>
  .page-intro__inner {
    max-width: 44rem;
  }

  .no-news {
    text-align: center;
    padding-block: 1rem;
  }

  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-bottom: 2rem;
  }

  .filter-btn {
    font: inherit;
    font-weight: 600;
    font-size: 0.9rem;
    padding: 0.5em 1.1em;
    border-radius: var(--radius-sm);
    border: 1.5px solid var(--color-border);
    background: var(--color-surface);
    color: var(--color-text);
    cursor: pointer;
  }

  .filter-btn[aria-pressed='true'] {
    background: var(--color-navy-900);
    border-color: var(--color-navy-900);
    color: #fff;
  }
</style>
