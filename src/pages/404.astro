---
import BaseLayout from '../layouts/BaseLayout.astro';
import { withBase } from '../lib/url';
---

<BaseLayout title="Page not found" description="The page you're looking for could not be found." noindex={true}>
  <section class="section not-found">
    <div class="container center">
      <p class="eyebrow">404</p>
      <h1>Page not found</h1>
      <p class="text-muted">Sorry, we couldn't find the page you were looking for.</p>
      <a class="btn btn-primary" href={withBase('/')}>Back to homepage</a>
    </div>
  </section>
</BaseLayout>

<style>
  .not-found {
    padding-block: 6rem;
  }
</style>
