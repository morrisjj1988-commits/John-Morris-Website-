---
// Stand-in for a real photo until the client supplies one (see README).
// Renders as an accessible, labelled graphic rather than a raster image.
interface Props {
  label: string;
  tone?: 'navy' | 'red' | 'gold';
  ratio?: string; // CSS aspect-ratio value, e.g. "1 / 1" or "4 / 3"
  class?: string;
}

const { label, tone = 'navy', ratio = '4 / 3', class: className = '' } = Astro.props;
---

<div
  class:list={['placeholder-photo', `tone-${tone}`, className]}
  style={`aspect-ratio: ${ratio};`}
  role="img"
  aria-label={label}
>
  <svg viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false">
    <path
      d="M4 8.5C4 7.11929 5.11929 6 6.5 6H8.17071C8.70115 6 9.20986 5.78929 9.58579 5.41421L10.4142 4.58579C10.7901 4.21071 11.2988 4 11.8293 4H12.1707C12.7012 4 13.2099 4.21071 13.5858 4.58579L14.4142 5.41421C14.7901 5.78929 15.2988 6 15.8293 6H17.5C18.8807 6 20 7.11929 20 8.5V16.5C20 17.8807 18.8807 19 17.5 19H6.5C5.11929 19 4 17.8807 4 16.5V8.5Z"
      stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"
    ></path>
    <circle cx="12" cy="12.5" r="3.25" stroke="currentColor" stroke-width="1.4"></circle>
  </svg>
  <span class="placeholder-photo__label">{label}</span>
</div>

<style>
  .placeholder-photo {
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.6rem;
    border-radius: var(--radius-md);
    color: rgba(255, 255, 255, 0.92);
    padding: 1.5rem;
    text-align: center;
  }

  .placeholder-photo svg {
    width: 2.25rem;
    height: 2.25rem;
    opacity: 0.85;
  }

  .placeholder-photo__label {
    font-size: 0.85rem;
    font-weight: 600;
    max-width: 22ch;
    line-height: 1.4;
  }

  .tone-navy {
    background: linear-gradient(135deg, var(--color-navy-700), var(--color-navy-900));
  }

  .tone-red {
    background: linear-gradient(135deg, var(--color-red-600), var(--color-navy-900));
  }

  .tone-gold {
    background: linear-gradient(135deg, var(--color-gold-500), var(--color-red-700));
  }
</style>
