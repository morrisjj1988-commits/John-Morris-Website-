---
import { Icon } from 'astro-icon/components';
import { socialLinks } from '../lib/site';

interface Props {
  variant?: 'light' | 'dark';
  size?: number;
}

const { variant = 'dark', size = 20 } = Astro.props;
---

<ul class:list={['social-bar', `variant-${variant}`]}>
  {socialLinks.map((link) => (
    <li>
      <a
        href={link.url}
        target="_blank"
        rel="noopener noreferrer"
        aria-label={`${link.platform} — ${link.handle} (opens in new tab)`}
        title={`${link.platform}: ${link.handle}`}
      >
        <Icon name={link.icon} width={size} height={size} aria-hidden="true" />
      </a>
    </li>
  ))}
</ul>

<style>
  .social-bar {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .social-bar a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.4rem;
    height: 2.4rem;
    border-radius: 50%;
    transition: background-color 0.15s ease, color 0.15s ease, transform 0.15s ease;
  }

  .social-bar a:hover {
    transform: translateY(-2px);
  }

  .variant-dark a {
    background: rgba(15, 31, 56, 0.06);
    color: var(--color-navy-900);
  }

  .variant-dark a:hover {
    background: var(--color-navy-900);
    color: #fff;
  }

  @media (prefers-color-scheme: dark) {
    .variant-dark a {
      background: rgba(255, 255, 255, 0.08);
      color: #fff;
    }
  }

  .variant-light a {
    background: rgba(255, 255, 255, 0.14);
    color: #fff;
  }

  .variant-light a:hover {
    background: #fff;
    color: var(--color-navy-900);
  }
</style>
