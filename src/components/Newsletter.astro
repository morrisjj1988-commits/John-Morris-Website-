---
import { withBase } from '../lib/url';
import { site } from '../lib/site';

interface Props {
  compact?: boolean;
  formspreeEndpoint?: string;
}

const { compact = false, formspreeEndpoint } = Astro.props;
---

<div class:list={['newsletter card', { 'newsletter--compact': compact }]}>
  <div class="newsletter__copy">
    <h2>Get local updates by email</h2>
    <p class="text-muted">
      Occasional emails on casework wins, local consultations, and what I'm working on for Canning Town South.
      Unsubscribe any time.
    </p>
  </div>

  <form
    class="newsletter__form"
    data-newsletter-form
    novalidate
    {...formspreeEndpoint
      ? { method: 'POST', action: formspreeEndpoint, 'data-formspree-endpoint': formspreeEndpoint }
      : {}}
  >
    <div class="form-field newsletter__email-field">
      <label for="newsletter-email">Email address</label>
      <input id="newsletter-email" name="email" type="email" autocomplete="email" required />
    </div>

    <div class="checkbox-field">
      <input id="newsletter-consent" name="consent" type="checkbox" required />
      <label for="newsletter-consent">
        I'd like to receive email updates from Cllr John Morris and agree to the{' '}
        <a href={withBase('/legal/privacy-policy/')}>Privacy Policy</a>. You can unsubscribe at any time.
      </label>
    </div>

    <button type="submit" class="btn btn-primary">Sign up</button>

    <p class="form-note" role="status" aria-live="polite" data-newsletter-status hidden>
      {formspreeEndpoint
        ? "Thanks for signing up!"
        : 'Thanks for signing up! (This is a working preview — connect it to a mailing list provider before launch.)'}
    </p>
    {formspreeEndpoint && (
      <p class="form-note" role="alert" aria-live="assertive" data-newsletter-error hidden>
        Sorry, something went wrong signing you up. Please try again, or email {' '}
        <a href={`mailto:${site.email}`}>{site.email}</a> directly.
      </p>
    )}
  </form>
</div>

<script>
  document.querySelectorAll<HTMLFormElement>('[data-newsletter-form]').forEach((form) => {
    form.addEventListener('submit', (event) => {
      if (!form.checkValidity()) {
        event.preventDefault();
        form.reportValidity();
        return;
      }

      const endpoint = form.dataset.formspreeEndpoint;
      const status = form.querySelector<HTMLElement>('[data-newsletter-status]');
      const errorNote = form.querySelector<HTMLElement>('[data-newsletter-error]');

      if (endpoint) {
        event.preventDefault();
        if (errorNote) errorNote.hidden = true;

        const submitButton = form.querySelector<HTMLButtonElement>('button[type="submit"]');
        if (submitButton) submitButton.disabled = true;

        fetch(endpoint, {
          method: 'POST',
          body: new FormData(form),
          headers: { Accept: 'application/json' },
        })
          .then((response) => {
            if (!response.ok) throw new Error('Newsletter sign-up failed');
            if (status) status.hidden = false;
            form.reset();
          })
          .catch(() => {
            if (errorNote) errorNote.hidden = false;
          })
          .finally(() => {
            if (submitButton) submitButton.disabled = false;
          });
        return;
      }

      event.preventDefault();
      if (status) {
        status.hidden = false;
      }
      form.reset();
    });
  });
</script>

<style>
  .newsletter {
    padding: 2.25rem;
    display: grid;
    gap: 1.75rem;
    grid-template-columns: 1.1fr 1.4fr;
    align-items: start;
    background: var(--color-red-600);
    color: #fff;
  }

  .newsletter :global(a) {
    color: #fff;
    text-decoration: underline;
  }

  .newsletter__copy h2 {
    font-size: 1.5rem;
    color: #fff;
  }

  .newsletter :global(.text-muted) {
    color: #f3dad4;
  }

  .newsletter__form .checkbox-field {
    margin-top: 0.9rem;
  }

  .newsletter__form :global(.checkbox-field label) {
    color: #fff;
  }

  .newsletter__email-field {
    max-width: 24rem;
  }

  .newsletter__form :global(input) {
    border: 2px solid #fff;
    background: var(--color-red-700);
    color: #fff;
  }

  .newsletter__form :global(input::placeholder) {
    color: #f3dad4;
  }

  .newsletter :global(.btn-primary) {
    background: var(--color-navy-900);
    border-color: var(--color-navy-900);
  }

  .newsletter :global(.btn-primary:hover) {
    background: #0e1830;
  }

  .newsletter :global(.form-note) {
    color: #fff;
  }

  .newsletter--compact {
    grid-template-columns: 1fr;
    padding: 1.75rem;
  }

  @media (max-width: 700px) {
    .newsletter {
      grid-template-columns: 1fr;
      padding: 1.75rem;
    }
  }
</style>
