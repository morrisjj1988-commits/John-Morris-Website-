---
import SitePhoto from './SitePhoto.astro';
import { withBase } from '../lib/url';
import { site } from '../lib/site';
import headshot from '../assets/images/headshot.jpg';
---

<section class="hero">
  <svg class="hero__boundary" viewBox="0 0 400 400" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false">
    <path
      d="M60 40 L150 20 L230 55 L300 40 L360 110 L340 190 L370 260 L300 320 L220 360 L140 340 L70 300 L30 220 L50 150 L20 90 Z"
      fill="none" stroke="var(--color-paper)" stroke-width="2.5"
    ></path>
    <circle cx="230" cy="180" r="4" fill="var(--color-gold-500)"></circle>
  </svg>
  <div class="container hero__inner">
    <div class="hero__copy">
      <p class="eyebrow">Your local councillor for Canning Town South</p>
      <h1>Working hard for Canning Town South</h1>
      <p class="hero__lede">
        I'm John Morris. A Newham councillor since 2022, I'm proud to now represent Canning Town South. From
        housing and bins to planning and anti-social behaviour, I'm here to help you get problems sorted and
        to stand up for our community.
      </p>
      <div class="hero__actions">
        <a class="btn btn-primary" href={withBase('/contact/')}>Get in touch</a>
        <a class="btn btn-secondary" href={withBase('/find-help/')}>See how I can help</a>
      </div>
    </div>
    <div class="hero__media">
      <div class="hero__photo-frame">
        <SitePhoto image={headshot} alt="John Morris at a Newham Council community engagement event in Canning Town" ratio="1 / 1" priority />
        <p class="hero__photo-caption">{site.ward}, London Borough of Newham</p>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    background: var(--color-navy-900);
    color: var(--color-paper);
    overflow: hidden;
  }

  .hero__boundary {
    position: absolute;
    right: -8%;
    top: -10%;
    width: 70%;
    max-width: 640px;
    opacity: 0.14;
    z-index: 0;
    pointer-events: none;
  }

  .hero__inner {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: 1.2fr 0.8fr;
    gap: 3rem;
    align-items: center;
    padding-block: clamp(2.5rem, 6vw, 5rem);
  }

  .hero h1 {
    color: var(--color-paper);
  }

  .hero .eyebrow {
    color: var(--color-gold-500);
  }

  .hero__lede {
    font-size: 1.15rem;
    color: #d9dee7;
    max-width: 40rem;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: 1.5rem;
  }

  .hero__media {
    max-width: 22rem;
    margin-inline: auto;
    width: 100%;
  }

  .hero__photo-frame {
    position: relative;
    border-radius: var(--radius-md);
    overflow: hidden;
  }

  .hero__photo-frame :global(.site-photo) {
    border: 1px solid rgba(246, 243, 236, 0.18);
  }

  .hero__photo-caption {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    margin: 0;
    background: rgba(22, 35, 59, 0.82);
    backdrop-filter: blur(2px);
    font-family: var(--font-mono);
    font-size: 11px;
    color: #d9dee7;
    padding: 10px 14px;
    letter-spacing: 0.02em;
  }

  @media (max-width: 820px) {
    .hero__inner {
      grid-template-columns: 1fr;
    }

    .hero__media {
      max-width: 16rem;
      order: -1;
    }
  }
</style>
