---
// Static-site form. By default this is a placeholder — on submit it shows
// an inline confirmation rather than actually sending data anywhere (see
// README). Two ways to wire a specific instance up for real:
// - `netlify` + a unique `netlifyFormName`: uses Netlify Forms — requires
//   the site to actually be deployed via Netlify (not GitHub Pages).
// - `formspreeEndpoint`: submits via fetch() to a Formspree form endpoint
//   (https://formspree.io/f/xxxxxxxx) — works from any host, since it's a
//   plain API call rather than something tied to the hosting platform.
import { withBase } from '../lib/url';
import { site } from '../lib/site';

interface Props {
  variant?: 'casework' | 'general';
  formId?: string;
  netlify?: boolean;
  netlifyFormName?: string;
  formspreeEndpoint?: string;
}

const {
  variant = 'general',
  formId = 'contact-form',
  netlify = false,
  netlifyFormName = 'contact',
  formspreeEndpoint,
} = Astro.props;

const isWired = netlify || Boolean(formspreeEndpoint);

const issueTypes = [
  'Housing',
  'Council Tax & Benefits',
  'Planning & Development',
  'Streets, Bins & Recycling',
  'Anti-Social Behaviour',
  'Something Else',
];
---

<form
  id={formId}
  class="contact-form"
  data-contact-form
  novalidate
  {...netlify
    ? {
        name: netlifyFormName,
        method: 'POST',
        'data-netlify': 'true',
        'data-netlify-honeypot': 'bot-field',
        action: withBase('/contact/thanks/'),
      }
    : formspreeEndpoint
      ? { method: 'POST', action: formspreeEndpoint, 'data-formspree-endpoint': formspreeEndpoint }
      : {}}
>
  {netlify && (
    <>
      <input type="hidden" name="form-name" value={netlifyFormName} />
      <p style="display:none;" aria-hidden="true">
        <label>
          Don't fill this out if you're human: <input name="bot-field" tabindex="-1" autocomplete="off" />
        </label>
      </p>
    </>
  )}
  <div class="form-row">
    <div class="form-field">
      <label for={`${formId}-name`}>Full name</label>
      <input id={`${formId}-name`} name="name" type="text" autocomplete="name" required />
    </div>
    <div class="form-field">
      <label for={`${formId}-email`}>Email address</label>
      <input id={`${formId}-email`} name="email" type="email" autocomplete="email" required />
    </div>
  </div>

  {variant === 'casework' && (
    <div class="form-row">
      <div class="form-field">
        <label for={`${formId}-address`}>Home address</label>
        <span id={`${formId}-address-hint`} class="hint">Needed so I can check you're a Canning Town South resident</span>
        <input id={`${formId}-address`} name="address" type="text" autocomplete="street-address" aria-describedby={`${formId}-address-hint`} required />
      </div>
      <div class="form-field">
        <label for={`${formId}-issue`}>Issue type</label>
        <select id={`${formId}-issue`} name="issue" required>
          <option value="" selected disabled>Choose an issue type</option>
          {issueTypes.map((issue) => <option value={issue}>{issue}</option>)}
        </select>
      </div>
    </div>
  )}

  {variant === 'general' && (
    <div class="form-field">
      <label for={`${formId}-subject`}>Subject</label>
      <input id={`${formId}-subject`} name="subject" type="text" required />
    </div>
  )}

  <div class="form-field">
    <label for={`${formId}-message`}>{variant === 'casework' ? 'Tell me what’s happening' : 'Message'}</label>
    <textarea id={`${formId}-message`} name="message" rows="5" required></textarea>
  </div>

  <div class="checkbox-field">
    <input id={`${formId}-consent`} name="consent" type="checkbox" required />
    <label for={`${formId}-consent`}>
      I consent to Cllr Morris's office storing my details in order to respond to this enquiry, in line with the{' '}
      <a href={withBase('/legal/privacy-policy/')}>Privacy Policy</a>.
    </label>
  </div>

  <button type="submit" class="btn btn-primary">Send message</button>

  {!netlify && (
    <p class="form-note" role="status" aria-live="polite" data-form-status hidden>
      {isWired
        ? 'Thanks — your message has been sent.'
        : "Thanks — your message has been noted. This form is a working preview; connect it to a real inbox before launch (see README)."}
    </p>
  )}
  {formspreeEndpoint && (
    <p class="form-note" role="alert" aria-live="assertive" data-form-error hidden>
      Sorry, something went wrong sending your message. Please try again, or email {' '}
      <a href={`mailto:${site.email}`}>{site.email}</a> directly.
    </p>
  )}
</form>

<script>
  document.querySelectorAll<HTMLFormElement>('[data-contact-form]').forEach((form) => {
    form.addEventListener('submit', (event) => {
      if (!form.checkValidity()) {
        event.preventDefault();
        form.reportValidity();
        return;
      }

      // Netlify-wired forms submit for real (to Netlify's form-handling
      // endpoint) — let the browser's normal POST + redirect happen.
      if (form.hasAttribute('data-netlify')) {
        return;
      }

      const endpoint = form.dataset.formspreeEndpoint;
      const status = form.querySelector<HTMLElement>('[data-form-status]');
      const errorNote = form.querySelector<HTMLElement>('[data-form-error]');

      if (endpoint) {
        event.preventDefault();
        if (errorNote) errorNote.hidden = true;

        const submitButton = form.querySelector<HTMLButtonElement>('button[type="submit"]');
        if (submitButton) submitButton.disabled = true;

        fetch(endpoint, {
          method: 'POST',
          body: new FormData(form),
          headers: { Accept: 'application/json' },
        })
          .then((response) => {
            if (!response.ok) throw new Error('Form submission failed');
            if (status) status.hidden = false;
            form.reset();
          })
          .catch(() => {
            if (errorNote) errorNote.hidden = false;
          })
          .finally(() => {
            if (submitButton) submitButton.disabled = false;
          });
        return;
      }

      event.preventDefault();
      if (status) {
        status.hidden = false;
      }
      form.reset();
    });
  });
</script>
