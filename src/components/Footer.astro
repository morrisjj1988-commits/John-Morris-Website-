---
import SocialBar from './SocialBar.astro';
import { footerNav, site } from '../lib/site';
import { withBase } from '../lib/url';

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container footer-grid">
    <div class="footer-brand">
      <p class="footer-brand__name">{site.name}</p>
      <p class="text-muted">{site.role}<br />{site.council}</p>
      <p class="footer-social-label">Stay updated on social media</p>
      <SocialBar variant="light" />
    </div>

    <nav class="footer-links" aria-label="Footer">
      <h2>Quick links</h2>
      <ul>
        {footerNav.map((link) => (
          <li><a href={withBase(link.href)}>{link.label}</a></li>
        ))}
      </ul>
    </nav>

    <div class="footer-contact">
      <h2>Contact</h2>
      <ul class="footer-contact__list">
        <li><a href={`mailto:${site.email}`}>{site.email}</a></li>
        <li><a href={`tel:${site.phone.replace(/\s+/g, '')}`}>{site.phone}</a></li>
        <li>{site.officeAddress}</li>
      </ul>
    </div>
  </div>

  <div class="container footer-bottom">
    <p>&copy; {year} {site.name}. All rights reserved.</p>
    <p class="imprint">{site.imprint}</p>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--color-navy-900);
    color: rgba(255, 255, 255, 0.85);
    margin-top: 4rem;
  }

  .footer-grid {
    display: grid;
    gap: 2.5rem;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    padding-block: 3rem 2rem;
  }

  .footer-brand__name {
    font-family: var(--font-heading);
    font-size: 1.3rem;
    font-weight: 800;
    color: #fff;
    margin-bottom: 0.3rem;
  }

  .footer-brand .text-muted {
    color: rgba(255, 255, 255, 0.7);
  }

  .footer-social-label {
    margin-top: 1.25rem;
    margin-bottom: 0.6rem;
    font-weight: 700;
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: rgba(255, 255, 255, 0.6);
  }

  .site-footer h2 {
    font-family: var(--font-mono);
    font-weight: 500;
    color: var(--color-gold-500);
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    margin-bottom: 1rem;
  }

  .footer-links ul,
  .footer-contact__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .footer-links a,
  .footer-contact__list a {
    color: rgba(255, 255, 255, 0.85);
    text-decoration: none;
  }

  .footer-links a:hover,
  .footer-contact__list a:hover {
    text-decoration: underline;
  }

  .footer-contact__list li {
    color: rgba(255, 255, 255, 0.85);
  }

  .footer-bottom {
    border-top: 1px solid rgba(255, 255, 255, 0.15);
    padding-block: 1.5rem;
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5rem;
    font-size: 0.8rem;
    color: rgba(255, 255, 255, 0.6);
  }

  .footer-bottom p {
    margin: 0;
  }

  .imprint {
    max-width: 46rem;
  }
</style>
