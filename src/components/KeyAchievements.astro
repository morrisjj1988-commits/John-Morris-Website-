---
// Counter strip of headline Newham figures, styled after the site's
// navy / brick / gold palette. Figures are council-wide achievements,
// so the copy credits Newham rather than claiming personal delivery.
const achievements = [
  {
    figure: '13th → 8th',
    srFigure: '13th to 8th',
    label: 'Places climbed in the 2025 London Healthy Streets Scorecard, winning Most Improved Borough',
  },
  {
    figure: '99%',
    label: "Of Newham's roads now 20mph, up from 41% in a year",
  },
  {
    figure: '64%',
    label: 'Average fall in traffic on Healthy School Streets, and up to 80% at some',
  },
  {
    figure: '22%',
    label: 'Rise in walking, cycling and scooting at monitored schools',
  },
  {
    figure: '£51m',
    label: 'Active and sustainable travel programme, 2023–2031',
  },
  {
    figure: '£34.69m',
    label: 'Invested in the Royal Docks Corridor',
  },
];
---

<section class="section achievements" aria-labelledby="achievements-title">
  <div class="container">
    <div class="section-header achievements__header">
      <p class="eyebrow">Key achievements</p>
      <h2 id="achievements-title">What Newham has delivered</h2>
      <p class="text-muted">
        Safer, healthier streets across the borough, which I'm proud to support as your councillor.
      </p>
    </div>

    <ul class="achievements__grid" role="list">
      {achievements.map((item) => (
        <li class="achievement">
          <p class="achievement__figure">
            {item.srFigure ? (
              <>
                <span aria-hidden="true">{item.figure}</span>
                <span class="sr-only">{item.srFigure}</span>
              </>
            ) : (
              item.figure
            )}
          </p>
          <p class="achievement__label">{item.label}</p>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .achievements__header {
    margin-inline: auto;
    text-align: center;
  }

  .achievements__grid {
    list-style: none;
    margin: 2.5rem 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 2.25rem 2rem;
  }

  .achievement {
    border-top: 3px solid var(--color-navy-900);
    padding-top: 1.1rem;
    text-align: center;
  }

  .achievement__figure {
    font-family: var(--font-heading);
    font-weight: 900;
    font-size: clamp(2.4rem, 3.5vw + 1rem, 3.6rem);
    line-height: 1;
    letter-spacing: -0.02em;
    color: var(--color-red-600);
    margin: 0 0 0.6rem;
    white-space: nowrap;
  }

  .achievement__label {
    color: var(--color-text-muted);
    font-size: 0.98rem;
    line-height: 1.45;
    margin: 0 auto;
    max-width: 30ch;
  }

  @media (prefers-color-scheme: dark) {
    .achievement {
      border-top-color: var(--color-gold-500);
    }

    .achievement__figure {
      color: #ff6b5e;
    }
  }

  @media (max-width: 860px) {
    .achievements__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 520px) {
    .achievements__grid {
      grid-template-columns: 1fr;
      gap: 1.75rem;
    }
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
</style>
