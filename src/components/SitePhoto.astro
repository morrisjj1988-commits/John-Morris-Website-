---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  image: ImageMetadata;
  alt: string;
  ratio?: string;
  widths?: number[];
  sizes?: string;
  class?: string;
  priority?: boolean;
}

const {
  image,
  alt,
  ratio = '4 / 3',
  widths = [320, 480, 640, 960],
  sizes = '(min-width: 820px) 22rem, 60vw',
  class: className = '',
  priority = false,
} = Astro.props;
---

<div class:list={['site-photo', className]} style={`aspect-ratio: ${ratio};`}>
  <Image
    src={image}
    alt={alt}
    widths={widths}
    sizes={sizes}
    loading={priority ? 'eager' : 'lazy'}
    fetchpriority={priority ? 'high' : 'auto'}
  />
</div>

<style>
  .site-photo {
    width: 100%;
    border-radius: var(--radius-md);
    overflow: hidden;
    box-shadow: var(--shadow-card);
  }

  .site-photo :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
</style>
